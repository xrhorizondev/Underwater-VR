{
  "schemaVersion": 1,
  "name": "android",
  "displayName": "Android APK",
  "buildTarget": "Android",
  "artifactKind": "apk",
  "artifactExtension": ".apk",
  "applicationIdentifier": "",
  "scenes": [],
  "orientation": "auto",
  "scriptingBackend": "IL2CPP",
  "requiredArchitectures": [ "ARM64" ],
  "supportedUnityMajorVersions": [ 2022, 6000 ],
  "urp": {
    "required": true,
    "minRenderScale": 0.0,
    "maxRenderScale": 1.0,
    "requireHdrOff": false
  },
  "signing": {
    "requireCustomKeystore": false,
    "disallowDebugSigning": false
  },
  "obb": {
    "enabled": false,
    "required": false,
    "expectedVersionCode": 0,
    "packageIdentifier": ""
  },
  "validation": {
    "requireArm64Library": true,
    "requireAndroidManifest": true,
    "requireNonEmptyArtifact": true
  },
  "developmentBuild": false
}
